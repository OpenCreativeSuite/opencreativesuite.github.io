<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Browser-only Donkeh application.

    The Donkeh packages carry the host wiring (browser SDK imports, entry-point
    generation, host page fallback, publish folder and flattening). There is no
    local framework checkout or path-based import.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-browser</TargetFrameworks>
    <RootNamespace>OpenCreativeSuite</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <DonkehVersion>1.0.44</DonkehVersion>

    <!-- Keep the site's custom Main so browser interop initializes first. -->
    <DonkehGenerateEntryPoint>false</DonkehGenerateEntryPoint>

    <RuntimeIdentifiers Condition="'$(TargetFramework)' == ''">browser-wasm</RuntimeIdentifiers>

    <DefaultItemExcludes>$(DefaultItemExcludes);builds/**;docs/**</DefaultItemExcludes>
    <!-- The site is English-only and does not need ICU globalization data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Donkeh.Windowing supplies the buildTransitive host wiring. Its desktop
      compile/runtime assets are not part of a browser build.
    -->
    <PackageReference Include="Donkeh.Windowing"
                      Version="$(DonkehVersion)"
                      ExcludeAssets="compile;runtime" />
    <PackageReference Include="Donkeh.Windowing.Browser"
                      Version="$(DonkehVersion)"
                      Condition="'$(TargetFramework)' == 'net10.0-browser'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"
                      Version="10.0.10"
                      Condition="'$(TargetFramework)' == 'net10.0-browser'" />
    <PackageReference Include="Microsoft.NET.Sdk.WebAssembly.Pack"
                      Version="10.0.11"
                      PrivateAssets="all"
                      GeneratePathProperty="true"
                      Condition="'$(TargetFramework)' == 'net10.0-browser'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content and design system are embedded in the application assembly. -->
    <EmbeddedResource Include="content.json" />
    <EmbeddedResource Include="assets/css/site.css" />
    <EmbeddedResource Include="src/Styles/app-shell.css" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Screenshots and icons are served as ordinary static files. Linking them
      into wwwroot keeps one copy in the repository while still publishing them
      beside the WebAssembly host.
    -->
    <None Remove="assets/**" />
    <Content Include="assets/img/**/*"
             Link="wwwroot/assets/img/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
