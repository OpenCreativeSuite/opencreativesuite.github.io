<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The framework checkout owns the platform wiring. This project only opts in
    to the browser target and declares its content, assets and stylesheets.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == ''">browser-wasm</RuntimeIdentifiers>
    <DonkehVersion>1.0.44</DonkehVersion>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <DonkehDesktop>false</DonkehDesktop>
    <DonkehWeb>true</DonkehWeb>
  </PropertyGroup>


  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenCreativeSuite</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- The app supplies its own Main so it can initialize site interop first. -->
    <DonkehGenerateEntryPoint>false</DonkehGenerateEntryPoint>

    <DefaultItemExcludes>$(DefaultItemExcludes);builds/**;docs/**</DefaultItemExcludes>
    <!-- The site is English-only and does not need ICU globalization data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Identifies this project to Directory.Build.targets. -->
    <IsOpenCreativeSuite>true</IsOpenCreativeSuite>
  </PropertyGroup>

  <ItemGroup>
    <!-- Content and design system are embedded in the application assembly. -->
    <EmbeddedResource Include="content.json" />
    <EmbeddedResource Include="assets/css/site.css" />
    <EmbeddedResource Include="src/Styles/app-shell.css" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Screenshots and icons are served as ordinary static files. Linking them
      into wwwroot keeps one copy in the repository while still publishing them
      beside the WebAssembly host.
    -->
    <None Remove="assets/**" />
    <Content Include="assets/img/**/*"
             Link="wwwroot/assets/img/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Donkeh.Windowing" Version="$(DonkehVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Donkeh.Windowing.Browser" Version="$(DonkehVersion)" Condition="'$(TargetFramework)' == 'net10.0-browser'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" Condition="'$(TargetFramework)' == 'net10.0-browser'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="10.0.11" Condition="'$(TargetFramework)' == 'net10.0-browser'" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
