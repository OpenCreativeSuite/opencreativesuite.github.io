<Project>

  <!--
    Resolve the Donkeh framework checkout.

    Order of preference:
      1. -p:DonkehRoot=... on the command line
      2. DONKEH_ROOT environment variable
      3. A sibling Donkeh checkout (for a portable CI layout)
      4. This machine's local framework checkout
  -->
  <PropertyGroup>
    <DonkehRoot Condition="'$(DonkehRoot)' == '' and '$(DONKEH_ROOT)' != ''">$(DONKEH_ROOT)</DonkehRoot>
    <DonkehRoot Condition="'$(DonkehRoot)' == '' and Exists('$(MSBuildThisFileDirectory)Donkeh\Build\Donkeh.props')">$(MSBuildThisFileDirectory)Donkeh</DonkehRoot>
    <DonkehRoot Condition="'$(DonkehRoot)' == '' and Exists('C:\Users\jhuds\Desktop\UI Framework\CSS-Engine\Donkeh\Build\Donkeh.props')">C:\Users\jhuds\Desktop\UI Framework\CSS-Engine\Donkeh</DonkehRoot>
  </PropertyGroup>

</Project>
